{
    "manifest_version": 3,
    "name": "Password Generator",
    "version": "1.10.0.1",
    "version_name": "1.10.0.1",
    "minimum_chrome_version": "124",
    "description": "Local password generator — injects a button next to password fields to generate and fill secure passwords. No KeePassXC connection required.",
    "author": "KeePassXC Team",
    "icons": {
        "16": "icons/keepassxc_16x16.png",
        "48": "icons/keepassxc_48x48.png",
        "64": "icons/keepassxc_64x64.png",
        "96": "icons/keepassxc_96x96.png",
        "128": "icons/keepassxc_128x128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/keepassxc_16x16.png",
            "32": "icons/keepassxc_32x32.png",
            "64": "icons/keepassxc_64x64.png"
        },
        "default_title": "Password Generator",
        "default_popup": "popups/popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "file:///*.xml*"
            ],
            "js": [
                "common/browser-polyfill.min.js",
                "common/global.js",
                "content/ui.js",
                "content/fields.js",
                "content/icon.js",
                "content/icon-handler.js",
                "content/pwgen.js",
                "content/keepassxc-browser.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "commands": {
        "show_password_generator": {
            "description": "__MSG_contextMenuShowPasswordGenerator__",
            "suggested_key": {
                "default": "Alt+Shift+G",
                "mac": "MacCtrl+Shift+G"
            }
        }
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icons/key.svg",
                "css/pwgen.css"
            ],
            "matches": [
                "https://*/*",
                "http://*/*"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'"
    },
    "default_locale": "en"
}
